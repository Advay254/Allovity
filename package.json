{
  "name": "allovity",
  "version": "1.1.0",
  "private": true,
  "description": "Allovity: Software Engineering Studio. Engineering what's next.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build:assets && tsx watch src/server.ts",
    "build:assets": "node scripts/build-assets.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "node scripts/clean.mjs && npm run build:server && npm run build:assets",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/browser",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build:assets",
    "test": "vitest run",
    "test:browser": "npm run build:assets && vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "compression": "1.8.2",
    "ejs": "3.1.10",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@types/compression": "1.8.1",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "lucide-static": "1.78.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "supertest": "7.3.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
