<div class="theme-control" role="group" aria-label="Colour theme">
  <button type="button" class="theme-control__option" data-theme-set="system" aria-pressed="false" aria-label="Use system theme"><%- icon('monitor') %></button>
  <button type="button" class="theme-control__option" data-theme-set="light" aria-pressed="false" aria-label="Use light theme"><%- icon('sun') %></button>
  <button type="button" class="theme-control__option" data-theme-set="dark" aria-pressed="false" aria-label="Use dark theme"><%- icon('moon') %></button>
</div>
