<section class="error-page" aria-labelledby="error-title">
  <div class="container-site error-page__inner">
    <svg class="error-art" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
      <g class="fill-primary">
        <rect x="8" y="8" width="34" height="34" rx="6"/>
        <rect x="54" y="8" width="34" height="34" rx="6"/>
        <rect x="8" y="54" width="34" height="34" rx="6"/>
      </g>
      <rect x="55" y="55" width="32" height="32" rx="6" fill="none" class="stroke-line-strong" stroke-width="2" stroke-dasharray="5 5"/>
    </svg>
    <p class="eyebrow">Error <span class="tabular-nums">404</span></p>
    <h1 id="error-title" class="font-bold text-h1">This page is not on the map.</h1>
    <p class="lead max-w-xl">The address may have changed, or it may never have existed. Head back to somewhere that does.</p>
    <div class="error-actions">
      <a class="btn btn-primary" href="/"><%- icon('house', 'h-5 w-5') %> Back to home</a>
      <a class="btn btn-secondary" href="/#studio">Visit the studio</a>
    </div>
  </div>
</section>
