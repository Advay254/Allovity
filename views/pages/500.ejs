<section class="error-page" aria-labelledby="error-title">
  <div class="container-site error-page__inner">
    <svg class="error-art" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
      <g class="fill-primary">
        <rect x="8" y="8" width="34" height="34" rx="6"/>
        <rect x="54" y="8" width="34" height="34" rx="6"/>
        <rect x="54" y="54" width="34" height="34" rx="6"/>
      </g>
      <rect x="9" y="55" width="32" height="32" rx="6" fill="none" class="stroke-danger" stroke-width="2"/>
    </svg>
    <p class="eyebrow">Error <span class="tabular-nums"><%= code %></span></p>
    <h1 id="error-title" class="font-bold text-h1"><%= heading %></h1>
    <p class="lead max-w-xl"><%= message %></p>
    <p class="reference">Reference: <%= requestId %></p>
    <div class="error-actions">
      <a class="btn btn-primary" href="/"><%- icon('house', 'h-5 w-5') %> Back to home</a>
      <a class="btn btn-secondary" href="/#studio">Visit the studio</a>
    </div>
  </div>
</section>
