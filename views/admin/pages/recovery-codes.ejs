<section class="admin-panel admin-panel--wide" aria-labelledby="page-title">
  <div class="admin-icon"><%- icon('key-round') %></div>
  <h1 id="page-title" class="text-h3 font-semibold"><%= heading %></h1>
  <div class="mt-4"><%- include('../partials/alert', { kind: 'warning', title: 'Shown only once', message: 'Save these 10 codes somewhere safe, such as a password manager. Each works once if you lose your phone. They cannot be shown again.' }) %></div>
  <%- include('../partials/codes', { codes: codes }) %>
  <form method="post" action="<%= adminBase %>/two-step/saved" class="mt-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-primary w-full">I have saved these</button>
  </form>
</section>
