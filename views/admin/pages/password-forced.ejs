<section class="admin-panel" aria-labelledby="page-title">
  <div class="admin-icon"><%- icon('key-round') %></div>
  <h1 id="page-title" class="text-h3 font-semibold">Choose a new password</h1>
  <p class="mt-2 text-small text-muted">Signed in as <%= me.email %>. Replace the temporary password before you continue.</p>
  <form class="form mt-6" method="post" action="<%= adminBase %>/password" data-submit-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/field', { id: 'password', name: 'password', label: 'New password', hint: 'At least 12 characters. A long phrase works well.', type: 'password', autocomplete: 'new-password', maxlength: 1024, autofocus: true, error: form.errors.password }) %>
    <%- include('../partials/field', { id: 'confirm', name: 'confirm', label: 'Repeat the new password', type: 'password', autocomplete: 'new-password', maxlength: 1024, error: form.errors.confirm }) %>
    <button type="submit" class="btn btn-primary w-full">Save password</button>
  </form>
  <form method="post" action="<%= adminBase %>/logout" class="mt-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-secondary btn-sm">Sign out</button>
  </form>
</section>
