<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= meta.title %> | <%= site.name %></title>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="theme-color" content="<%= site.themeColor %>">
  <meta name="color-scheme" content="only light">
  <link rel="icon" href="<%= asset('brand.symbol.svg') %>" type="image/svg+xml">
  <link rel="preload" href="<%= asset('font.space-grotesk') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= asset('font.inter') %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('admin.css') %>">
  <script src="<%= asset('page-init.js') %>"></script>
</head>
<body data-page="<%= meta.pageId %>">
  <a class="skip-link" href="#main" data-drawer-background>Skip to main content</a>
  <div class="admin-frame">
    <header class="admin-bar" data-drawer-background>
      <div class="admin-bar__start">
        <button type="button" class="menu-button" data-drawer-open aria-expanded="false" aria-controls="admin-drawer" aria-label="Open menu"><%- icon('menu', 'h-5 w-5') %></button>
        <span class="admin-brand"><%- include('../partials/symbol') %><%= site.name %><span class="hidden xs:inline">&nbsp;Admin</span></span>
      </div>
      <div class="admin-bar__end">
        <span class="admin-identity"><span class="admin-identity__name"><%= me.displayName %></span><span class="admin-identity__role"><%= me.role %></span></span>
        <form method="post" action="<%= adminBase %>/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-secondary btn-sm"><%- icon('log-out', 'h-4 w-4') %><span class="whitespace-nowrap">Sign out</span></button>
        </form>
      </div>
    </header>
    <div class="admin-body">
      <nav class="admin-side" aria-label="Admin" data-drawer-background>
        <%- include('partials/nav', { variant: 'side' }) %>
      </nav>
      <main id="main" class="admin-content" tabindex="-1" data-drawer-background>
        <%- body %>
      </main>
    </div>
    <p class="admin-foot" data-drawer-background>&copy; <span class="tabular-nums"><%= year %></span> <%= site.name %></p>
  </div>
  <div class="admin-drawer" id="admin-drawer" data-open="false" inert>
    <div class="admin-drawer__scrim" data-drawer-close></div>
    <div class="admin-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="admin-drawer__head">
        <span class="eyebrow">Menu</span>
        <button type="button" class="btn btn-secondary h-11 w-11 min-h-0 px-0" data-drawer-close aria-label="Close menu"><%- icon('x', 'h-5 w-5') %></button>
      </div>
      <nav aria-label="Admin mobile">
        <%- include('partials/nav', { variant: 'drawer' }) %>
      </nav>
    </div>
  </div>
  <script src="<%= asset('admin/shell.js') %>" defer></script>
  <% if (meta.pageScript) { %><script src="<%= asset(meta.pageScript) %>" defer></script><% } %>
</body>
</html>
