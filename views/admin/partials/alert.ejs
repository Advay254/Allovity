<div class="alert alert-<%= kind %>" role="<%= kind === 'danger' || kind === 'warning' ? 'alert' : 'status' %>">
  <%- icon(kind === 'success' ? 'circle-check' : (kind === 'info' ? 'info' : (kind === 'warning' ? 'triangle-alert' : 'circle-alert')), 'h-5 w-5') %>
  <div><% if (typeof title !== 'undefined' && title) { %><p class="alert__title"><%= title %></p><% } %><p><%= message %></p></div>
</div>
