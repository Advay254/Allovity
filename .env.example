# Copy these into your host's environment settings. Never commit real values.
# Full descriptions: docs/ENVIRONMENT.md

# Required
# ADMIN_PATH_SLUG: 4 to 20 characters (letters, digits, _ and -). 12 or more recommended.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PUBLIC_SITE_URL=https://www.example.com
ADMIN_PATH_SLUG=replace-with-slug

# Optional (defaults shown)
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUSTED_PROXY_HOPS=0
RUN_MIGRATIONS=true
DATABASE_SSL=auto
DATABASE_SSL_STRICT=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
SHUTDOWN_TIMEOUT_MS=10000

# Admin (required for the admin area to work; the public site runs without it)
# 43 to 256 characters of letters, digits, - _ + / or =. Generate one, never reuse it.
ADMIN_SECRET_KEY=replace-with-a-long-random-value-from-a-generator
# Used once, to create the first owner when no admin users exist. Remove the password afterwards.
ADMIN_INITIAL_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-long-passphrase

# Admin (optional, defaults shown)
ADMIN_REQUIRE_2FA=true
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=12
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ADMIN_EMERGENCY_RESET=false
